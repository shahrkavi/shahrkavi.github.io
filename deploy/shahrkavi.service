[Unit]
Description=Shahrkavi FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shahrkavi
Group=shahrkavi
WorkingDirectory=/opt/shahrkavi/fastapi
EnvironmentFile=-/opt/shahrkavi/fastapi/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/shahrkavi/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=30
ReadWritePaths=/opt/shahrkavi/fastapi/cache /opt/shahrkavi/fastapi/downloads /opt/shahrkavi/fastapi/bin/cache

[Install]
WantedBy=multi-user.target
